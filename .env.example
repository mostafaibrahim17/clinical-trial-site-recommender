# Arango Contextual Data Platform
ARANGO_HOST=https://your-deployment.arango.ai
ARANGO_DB=your_database_name
ARANGO_USER=your_username
ARANGO_PASSWORD=your_password
# OpenAI (embeddings + reasoning)
OPENAI_API_KEY=your_openai_key
# AutoGraph Retriever (dosage variable)
# Find the service ID in the AutoGraph interface under your deployed Retriever service.
RETRIEVER_HOST=https://your-deployment.arango.ai
RETRIEVER_SERVICE_ID=arangodb-graphrag-retriever-xxxxx